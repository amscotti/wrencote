if(WRENCOTE_HARDEN)
    include(CheckCCompilerFlag)
    check_c_compiler_flag("-fstack-protector-strong" WC_HAS_SSP)
    check_c_compiler_flag("-fstack-clash-protection" WC_HAS_CLASH)
    check_c_compiler_flag("-ftrivial-auto-var-init=zero" WC_HAS_ZERO_INIT)
    if(WC_HAS_SSP)
        add_compile_options(-fstack-protector-strong)
    endif()
    if(WC_HAS_CLASH)
        add_compile_options(-fstack-clash-protection)
    endif()
    if(WC_HAS_ZERO_INIT)
        add_compile_options(-ftrivial-auto-var-init=zero)
    endif()
    add_compile_definitions(_FORTIFY_SOURCE=3)
    add_link_options(-Wl,-z,relro,-z,now,-z,noexecstack)
endif()

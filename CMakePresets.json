{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WRENCOTE_SANITIZE": "ON",
        "WRENCOTE_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WRENCOTE_HARDEN": "ON",
        "WRENCOTE_WERROR": "ON"
      }
    },
    {
      "name": "ci-gcc",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-13"
      }
    },
    {
      "name": "ci-clang",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "zigcc"
      }
    },
    {
      "name": "coverage",
      "inherits": "dev",
      "cacheVariables": {
        "WRENCOTE_COVERAGE": "ON",
        "WRENCOTE_SANITIZE": "OFF"
      }
    },
    {
      "name": "tsan",
      "inherits": "dev",
      "cacheVariables": {
        "WRENCOTE_SANITIZE": "OFF",
        "WRENCOTE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc"
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "gate",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    }
  ]
}